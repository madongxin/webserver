# 邮件奖励隔离测试使用的变量名。把真实值放在未提交的本地配置里。
# 不要指向正式集群，不要在这里写数据库密码或 GAMEMESH_MAIL_DELIVER_TOKEN。
GAMEMESH_FORMAL=
GAMEMESH_ADVERTISE_HOST=
GAMEMESH_RUN_DIR=
# Login admission is per gateway process. 0 rejects new Login/Reconnect.
GAMEMESH_LOGIN_INFLIGHT_MAX=256
GAMEMESH_LOGIN_RECONNECT_RESERVE=32
# Stress stays on an isolated loopback cluster. Do not put a public EIP here.
GAMEMESH_STRESS_ALLOW_LARGE=
GAMEMESH_STRESS_ALLOW_REMOTE=
