<Window x:Class="GameMesh.WindowsTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameMesh Windows Test"
        Height="780" Width="1100"
        MinHeight="640" MinWidth="900"
        Background="#F4F6F8">
  <DockPanel Margin="12">
    <!-- 顶部连接 -->
    <Border DockPanel.Dock="Top" Padding="10" Background="White" BorderBrush="#D0D7DE" BorderThickness="1" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="160"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="80"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="Host" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBox Grid.Column="1" x:Name="TxtHost" Text="127.0.0.1" VerticalContentAlignment="Center" Height="28"/>
        <TextBlock Grid.Column="2" Text="Port" VerticalAlignment="Center" Margin="12,0,6,0"/>
        <TextBox Grid.Column="3" x:Name="TxtPort" Text="29081" VerticalContentAlignment="Center" Height="28"/>
        <Button Grid.Column="4" Content="连接" Width="72" Height="28" Margin="12,0,6,0" Click="BtnConnect_OnClick"/>
        <Button Grid.Column="5" Content="断开" Width="72" Height="28" Click="BtnDisconnect_OnClick"/>
        <TextBlock Grid.Column="6" x:Name="TxtConnStatus" Text="未连接" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#57606A"/>
      </Grid>
    </Border>

    <!-- 底部日志 -->
    <GroupBox DockPanel.Dock="Bottom" Header="日志" Height="150" Margin="0,10,0,0" Background="White">
      <TextBox x:Name="TxtLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
               FontFamily="Consolas" FontSize="12" BorderThickness="0" TextWrapping="Wrap"/>
    </GroupBox>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.1*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="1.2*"/>
      </Grid.ColumnDefinitions>

      <!-- 左：账号 + 背包 -->
      <StackPanel Grid.Column="0">
        <GroupBox Header="账号 · 注册 / 登录 / 下线" Background="White" Padding="8" Margin="0,0,0,10">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="90"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Text="device_id" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtDeviceId" Margin="0,2" Height="26"/>

            <TextBlock Grid.Row="1" Text="display_name" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtDisplayName" Text="wintest" Margin="0,2" Height="26"/>

            <TextBlock Grid.Row="2" Text="player_id" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtPlayerId" Margin="0,2" Height="26"/>

            <TextBlock Grid.Row="3" Text="token" VerticalAlignment="Center"/>
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtToken" IsReadOnly="True" Margin="0,2" Height="26"/>

            <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="注册" Width="72" Height="28" Margin="0,0,8,0" Click="BtnRegister_OnClick"/>
              <Button Content="登录" Width="72" Height="28" Margin="0,0,8,0" Click="BtnLogin_OnClick"/>
              <Button Content="下线" Width="72" Height="28" Click="BtnLogout_OnClick"/>
            </StackPanel>
          </Grid>
        </GroupBox>

        <GroupBox Header="道具 · 发放 + 背包（客户端按响应聚合）" Background="White" Padding="8">
          <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="item_id" VerticalAlignment="Center"/>
              <TextBox Grid.Column="1" x:Name="TxtItemId" Text="1001" Height="26" VerticalContentAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="count" VerticalAlignment="Center" Margin="8,0,4,0"/>
              <TextBox Grid.Column="3" x:Name="TxtItemCount" Text="1" Height="26" VerticalContentAlignment="Center"/>
              <Button Grid.Column="4" Content="发放道具" Width="88" Height="28" Margin="8,0,0,0" Click="BtnGrant_OnClick"/>
            </Grid>
            <ListBox x:Name="ListBag" Height="220"
                     DisplayMemberPath="Display"
                     BorderBrush="#D0D7DE"/>
          </DockPanel>
        </GroupBox>
      </StackPanel>

      <!-- 右：邮件 -->
      <GroupBox Grid.Column="2" Header="邮件 · 发信 / 列表 / 详情 / 领取" Background="White" Padding="8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.1*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.2*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="刷新列表" Width="88" Height="28" Margin="0,0,8,0" Click="BtnMailList_OnClick"/>
            <Button Content="查看详情" Width="88" Height="28" Margin="0,0,8,0" Click="BtnMailGet_OnClick"/>
            <Button Content="领取附件" Width="88" Height="28" Click="BtnMailClaim_OnClick"/>
          </StackPanel>

          <ListBox Grid.Row="1" x:Name="ListMails" DisplayMemberPath="Display"
                   BorderBrush="#D0D7DE" SelectionChanged="ListMails_OnSelectionChanged"/>

          <TextBlock Grid.Row="2" Text="详情" Margin="0,8,0,4" FontWeight="SemiBold"/>
          <TextBox Grid.Row="3" x:Name="TxtMailDetail" IsReadOnly="True"
                   VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                   FontFamily="Consolas" FontSize="12" BorderBrush="#D0D7DE"/>

          <GroupBox Grid.Row="4" Header="发信（MailDeliver → 自己）" Margin="0,8,0,0" Padding="6">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="60"/>
              </Grid.ColumnDefinitions>

              <TextBlock Text="标题" VerticalAlignment="Center"/>
              <TextBox Grid.Column="1" x:Name="TxtMailTitle" Text="测试邮件" Height="26" Margin="0,2"/>
              <TextBlock Grid.Column="2" Text="附件ID" VerticalAlignment="Center" Margin="8,0,4,0"/>
              <TextBox Grid.Column="3" x:Name="TxtMailAttachItem" Text="1002" Height="26" Margin="0,2"/>
              <TextBlock Grid.Column="4" Text="数量" VerticalAlignment="Center" Margin="8,0,4,0"/>
              <TextBox Grid.Column="5" x:Name="TxtMailAttachCount" Text="1" Height="26" Margin="0,2"/>

              <TextBlock Grid.Row="1" Text="正文" VerticalAlignment="Top" Margin="0,6,0,0"/>
              <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" x:Name="TxtMailBody"
                       Height="48" TextWrapping="Wrap" AcceptsReturn="True"
                       Text="来自 Windows 测试客户端" Margin="0,4,0,0"/>

              <CheckBox Grid.Row="2" Grid.Column="1" x:Name="ChkMailAttach"
                        Content="附带道具附件" IsChecked="True" Margin="0,6,0,0"/>
              <Button Grid.Row="2" Grid.Column="5" Content="发送" Height="28" Margin="0,4,0,0"
                      Click="BtnMailDeliver_OnClick"/>
            </Grid>
          </GroupBox>
        </Grid>
      </GroupBox>
    </Grid>
  </DockPanel>
</Window>
